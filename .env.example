# ── Supabase configuration ──────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your Supabase project values.
# You can find these in the Supabase dashboard: Project Settings → API.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Secret (server-only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Licensing endpoint ──────────────────────────────────────────────────
# Secret string used to derive activation tokens in /api/connect.
STATIC_WORDS=change-me-to-a-long-random-string
