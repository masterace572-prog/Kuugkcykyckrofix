# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
#
# Local dev: copy to `.env.local`
# Vercel:   add these under Project → Settings → Environment Variables
#           (they are stored encrypted as secrets; values below are examples).
#
# NOTE: Vercel does not automatically share variables across Preview /
# Production environments. After adding them, check "Preview" and
# "Production" so both get the values, then redeploy.
#
# Supabase dashboard → Project Settings → API for all three Supabase values.
# ─────────────────────────────────────────────────────────────────────────────

# ── PUBLIC (exposed to the browser — safe, guarded by Row Level Security) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── SECRET (server-only — NEVER start with NEXT_PUBLIC_) ────────────────────
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Secret string used to derive activation tokens in /api/connect.
# Generate a long random value, e.g. `openssl rand -hex 32`.
STATIC_WORDS=change-me-to-a-long-random-string
